# Poisoned Telemetry - local settings. NEVER commit this file or paste its contents anywhere.
# (It is listed in .gitignore.)

# --- Which provider our own agents, quarantine reader and judge use ---------
# openai | anthropic | fake (offline)
PT_LLM_PROVIDER=openai

# --- Keys (fill only the one you use) ----------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model IDs: copy EXACT IDs from your provider's models page ---------------
# Keep them unchanged for every experiment run, and record them in the report.
# Reasoning + judge: a capable model. Quarantine: a smaller, cheaper model.
PT_REASONING_MODEL=paste-model-id-here
PT_QUARANTINE_MODEL=paste-smaller-model-id-here
PT_JUDGE_MODEL=paste-model-id-here

# --- HolmesGPT (uses LiteLLM model strings) ----------------------------------
# For OpenAI: openai/<model-id>     For Anthropic: anthropic/<model-id>
HOLMES_MODEL=openai/paste-model-id-here
# Optional smaller model for HolmesGPT's own summariser set-up
HOLMES_FAST_MODEL=
# Path to the holmes command if it is not on your PATH
HOLMES_BIN=holmes

# --- Audit log --------------------------------------------------------------
# Generate with: make key
PT_AUDIT_KEY=
